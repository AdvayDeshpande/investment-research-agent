# Copy this file to .env and fill in your keys:  cp .env.example .env   (Windows: copy .env.example .env)

# Groq LLM API - free, no credit card: https://console.groq.com/keys -> "Create API Key"
GROQ_API_KEY=your_groq_api_key_here
# Optional: any Groq model with tool calling. llama-3.1-8b-instant has higher free rate limits.
GROQ_MODEL=llama-3.3-70b-versatile

# NewsAPI - free developer plan (100 requests/day): https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Optional tuning
# AGENT_MAX_STEPS=6
# LLM_TIMEOUT_SECONDS=30
# HTTP_TIMEOUT_SECONDS=10
